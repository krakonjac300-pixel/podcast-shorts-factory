<Project Sdk="Microsoft.NET.Sdk">
  <!-- Player build with Steamworks.NET installed (STEAMWORKS_NET, stubbed), Input System only -->
  <PropertyGroup>
    <AssemblyName>SecondCursor.Runtime</AssemblyName>
    <DefineConstants>$(UnityDefines);ENABLE_INPUT_SYSTEM;SC_INPUT_SYSTEM;STEAMWORKS_NET</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Scripts)/Runtime/**/*.cs" />
    <Compile Include="Stubs/InputSystemStub.cs" />
    <Compile Include="Stubs/SteamworksStub.cs" />
    <ProjectReference Include="Core.csproj" />
    <Reference Include="$(Deps)/engine/*.dll" Private="false" />
    <Reference Include="$(Deps)/ugui/UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
</Project>
