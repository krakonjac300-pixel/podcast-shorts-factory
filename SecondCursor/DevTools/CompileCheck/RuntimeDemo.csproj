<Project Sdk="Microsoft.NET.Sdk">
  <!-- The free demo player build (SC_DEMO: Night 1 only), legacy Input Manager active -->
  <PropertyGroup>
    <AssemblyName>SecondCursor.Runtime</AssemblyName>
    <DefineConstants>$(UnityDefines);ENABLE_LEGACY_INPUT_MANAGER;SC_DEMO</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Scripts)/Runtime/**/*.cs" />
    <ProjectReference Include="Core.csproj" />
    <Reference Include="$(Deps)/engine/*.dll" Private="false" />
    <Reference Include="$(Deps)/ugui/UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
</Project>
